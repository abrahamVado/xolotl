<!-- //1.- Manifest principal que declara permisos, activity y metadata de la app Flutter. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.mictlan_client">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- //3.- POST_NOTIFICATIONS asegura que Android 13+ permita mostrar avisos push. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- //2.- Habilita el callback moderno de regreso para evitar advertencias en Android 13+. -->
    <application
        android:label="mictlan_client"
        android:name="${applicationName}"
        android:icon="@drawable/ic_launcher"
        android:roundIcon="@drawable/ic_launcher_round"
        android:usesCleartextTraffic="true"
        android:enableOnBackInvokedCallback="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- //4.- Configura el canal predeterminado usado por flutter_local_notifications para FCM. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="folio_alerts" />
        <!-- //5.- Reutiliza el ícono principal para mostrar notificaciones personalizadas. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_launcher" />

        <meta-data android:name="com.google.android.geo.API_KEY" android:value="${MAPS_API_KEY}" />
        <meta-data android:name="flutterEmbedding" android:value="2" />
    </application>
</manifest>
